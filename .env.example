# QuizVerse Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# --- Database ---
DATABASE_URI=mysql+pymysql://root:yourpassword@localhost:3306/quizversedb

# --- Security Keys (use strong random strings in production) ---
SECRET_KEY=your-secret-key-change-me
JWT_SECRET_KEY=your-jwt-secret-key-change-me

# --- Admin Account (auto-created on first run) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@quizverse.com
ADMIN_PASSWORD=Admin@1234

# --- Flask Mail (for forgot-password OTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=QuizVerse <your_email@gmail.com>

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
